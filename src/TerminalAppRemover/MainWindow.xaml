<Window
    x:Class="TerminalAppRemover.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TerminalAppRemover"
    Title="Terminal App Remover">
    <Grid x:Name="RootGrid" Padding="28" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="Terminal App Remover" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Remove apps installed through common Windows package managers." Opacity="0.72" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" PlaceholderText="Search by name, id, or source..." TextChanged="SearchBox_TextChanged" />
            <Button x:Name="ScanButton" Grid.Column="1" Content="Scan" Click="ScanButton_Click" MinWidth="110" />
        </Grid>

        <Border Grid.Row="2" BorderThickness="1" CornerRadius="8" Padding="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <ListView x:Name="PackageList" SelectionMode="None" IsItemClickEnabled="False">
                <ListView.Header>
                    <Grid Padding="10,4" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.2*" />
                            <ColumnDefinition Width="1.05*" />
                            <ColumnDefinition Width="0.85*" />
                            <ColumnDefinition Width="1.0*" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Name" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="Version" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="Size" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="Source" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="4" Text="Action" FontWeight="SemiBold" />
                    </Grid>
                </ListView.Header>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:PackageEntry">
                        <Grid Padding="10,7" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.2*" />
                                <ColumnDefinition Width="1.05*" />
                                <ColumnDefinition Width="0.85*" />
                                <ColumnDefinition Width="1.0*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind DisplayId}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{x:Bind DisplayVersion}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{x:Bind DisplaySize}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{x:Bind Manager}" VerticalAlignment="Center" />
                            <Button Grid.Column="4" Content="Uninstall" Tag="{x:Bind}" Click="UninstallButton_Click" HorizontalAlignment="Left" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="Ready" Opacity="0.7" VerticalAlignment="Center" />
            <ProgressBar x:Name="LoadingBar" Grid.Column="1" Width="120" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
